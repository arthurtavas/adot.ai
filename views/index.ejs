<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Adote um Amigo</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <main class="main-sheet">
    <!-- TOPO PROFISSIONAL COM LOGO -->
    <header class="topo">
      <div class="topo-barra">
        <div class="marca-container">
          <img 
            src="/images/logo.png" 
            alt="Logo Adote um Amigo" 
            class="logo-site"
            onerror="this.style.display='none'; document.getElementById('logo-fallback').style.display='flex';"
          >
          <div id="logo-fallback" class="logo-placeholder" style="display: none;">🐾</div>

          <div class="marca-texto">
            <h1>Adote um Amigo</h1>
            <p>Encontre seu novo companheiro e agende sua visita</p>
          </div>
        </div>

        <a href="/loja" class="btn-loja">
         Área da Loja
        </a>
      </div>
    </header>

    <!-- AVISO DO "QUERO ADOTAR": o resultado vem do servidor (?interesse=...), não do navegador -->
    <% if (aviso === 'ok') { %>
      <div id="aviso-adocao" class="card-confirmacao" role="status">
        <div class="confirmacao-conteudo">
          <h3>🎉 Parabéns! Você ganhou seu novo amigo! 🐾</h3>
          <p>Que alegria! O <strong><%= petAviso %></strong> está ansioso para conhecer você. Já recebemos seu cadastro e nossa equipe entrará em contato pelo WhatsApp.</p>
          <div class="box-endereco">
            <p><strong>📍 Local para Buscar seu Novo Amigo:</strong></p>
            <p>Rua Batista de Carvalho, 12-40 — Centro, Bauru/SP</p>
            <p><strong>🕒 Horário de Atendimento:</strong> Segunda a Sábado, das 09h às 18h</p>
            <p><strong>📄 Documentos necessários:</strong> RG, CPF e comprovante de residência</p>
          </div>
          <button type="button" class="btn-primario" onclick="fecharAviso()">Entendi, mal posso esperar!</button>
        </div>
      </div>
    <% } else if (aviso) { %>
      <div id="aviso-adocao" class="card-confirmacao card-aviso" role="alert">
        <div class="confirmacao-conteudo">
          <% if (aviso === 'duplicado') { %>
            <h3>Você já demonstrou interesse neste pet 🐾</h3>
            <p>Já temos o seu contato para o <strong><%= petAviso %></strong>. Nossa equipe falará com você pelo WhatsApp, não precisa enviar de novo.</p>
          <% } else if (aviso === 'indisponivel') { %>
            <h3>Este pet não está mais disponível</h3>
            <p>Ele pode ter sido adotado ou removido da lista. Dê uma olhada nos outros amigos abaixo.</p>
          <% } else { %>
            <h3>Muitas solicitações em pouco tempo</h3>
            <p>Por segurança, limitamos o número de envios. Aguarde alguns minutos e tente novamente.</p>
          <% } %>
          <button type="button" class="btn-primario" onclick="fecharAviso()">Ok</button>
        </div>
      </div>
    <% } %>

    <!-- BARRA DE PESQUISA -->
    <section class="bloco">
      <form action="/" method="GET" class="form-inline">
        <input type="text" name="busca" value="<%= busca %>" placeholder="Pesquisar por nome do pet ou raça...">
        <button type="submit" class="btn-primario">Pesquisar</button>
        <% if (busca) { %>
          <a href="/" class="btn-secundario">Limpar</a>
        <% } %>
      </form>
    </section>

    <!-- VITRINE LIMPA DOS PETS -->
    <section class="bloco">
    <h2>Transforme uma vida: adote um melhor amigo 🐾</h2>
    <p style="color: #64748b; margin-top: -8px; margin-bottom: 24px;">
    Eles só precisam de uma chance e do seu amor ❤️
  </p>

      <div class="pets-grid">
        <% cachorros.forEach(dog => { %>
          <article class="pet-card">
            <img 
              src="<%= dog.foto || 'https://placedog.net/400/300?id=15' %>" 
              alt="<%= dog.nome %>" 
              class="pet-foto"
              loading="lazy"
              decoding="async"
            >
            <div class="pet-info">
              <div class="pet-header">
                <h3><%= dog.nome %></h3>
                <span class="badge-porte"><%= dog.porte %></span>
              </div>
              <p><strong>Raça:</strong> <%= dog.raca %></p>
              <p><strong>Idade:</strong> <%= dog.idade %></p>
              
              <button 
                type="button" 
                class="btn-adotar-card"
                data-nome="<%= dog.nome %>"
                data-raca="<%= dog.raca %>"
                data-foto="<%= dog.foto || 'https://placedog.net/400/300?id=15' %>"
                onclick="abrirModalAdocao(this)"
              >
                Quero Adotar
              </button>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <!-- MODAL POP-UP PARA O CLIENTE FINALIZAR A ADOÇÃO -->
  <div id="modal-adocao" class="modal-overlay" style="display: none;">
    <div class="modal-box">
      <button type="button" class="modal-fechar" onclick="fecharModalAdocao()">✕</button>
      
      <div class="modal-pet-resumo">
        <img id="modal-pet-img" src="" alt="Pet">
        <div>
          <span class="badge-porte">Adoção Responsável</span>
          <h3 id="modal-pet-nome"></h3>
          <p id="modal-pet-raca"></p>
        </div>
      </div>

      <form id="form-adocao-modal" action="/itens" method="POST" onsubmit="travarEnvio(this)">
        <input type="hidden" id="input-cachorro-interesse" name="cachorro_interesse">
        
        <label>Seu Nome Completo</label>
        <input type="text" name="nome_cliente" placeholder="Ex: Ana Paula Silva" maxlength="100" required>
        
        <label>Telefone / WhatsApp para Contato</label>
        <input type="tel" name="telefone" placeholder="Ex: (14) 99999-8888" maxlength="20" inputmode="tel" required>
        
        <label>Observação ou Melhor Horário (opcional)</label>
        <input type="text" name="observacao" placeholder="Ex: Posso visitar sábado de manhã" maxlength="255">
        
        <button type="submit" class="btn-primario" style="width: 100%; margin-top: 10px; padding: 14px;">
          Confirmar Interesse e Ver Local da Adoção
        </button>
      </form>
    </div>
  </div>

  <script>
    function abrirModalAdocao(botao) {
      const nome = botao.getAttribute('data-nome');
      const raca = botao.getAttribute('data-raca');
      const foto = botao.getAttribute('data-foto');

      document.getElementById('modal-pet-nome').innerText = nome;
      document.getElementById('modal-pet-raca').innerText = 'Raça: ' + raca;
      document.getElementById('modal-pet-img').src = foto;
      document.getElementById('input-cachorro-interesse').value = nome;
      document.getElementById('modal-adocao').style.display = 'flex';
    }

    function fecharModalAdocao() {
      document.getElementById('modal-adocao').style.display = 'none';
    }

    // Evita duplo clique/duplo envio. (A regra de verdade é aplicada no servidor; isto é só conforto de uso.)
    function travarEnvio(form) {
      const botao = form.querySelector('button[type="submit"]');
      botao.disabled = true;
      botao.textContent = 'Enviando...';
    }

    function fecharAviso() {
      const aviso = document.getElementById('aviso-adocao');
      if (aviso) aviso.style.display = 'none';
    }

    // Se o navegador restaurar a página pelo botão "voltar", destrava o botão de envio.
    window.addEventListener('pageshow', () => {
      const botao = document.querySelector('#form-adocao-modal button[type="submit"]');
      if (botao) {
        botao.disabled = false;
        botao.textContent = 'Confirmar Interesse e Ver Local da Adoção';
      }
    });

    // Limpa ?interesse=...&pet=... da barra de endereço: ao atualizar a página, o aviso não reaparece.
    window.addEventListener('DOMContentLoaded', () => {
      if (document.getElementById('aviso-adocao')) history.replaceState(null, '', location.pathname);
    });
  </script>
</body>
</html>