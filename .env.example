# ---------- Banco de dados ----------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=bdnode
# DB_POOL_SIZE=10

# ---------- Área da loja (OBRIGATÓRIO: a aplicação não inicia sem estes dois) ----------
# Gere com:  npm run gerar-credenciais   (e cole as linhas geradas aqui, no seu .env)
# Use aspas simples no hash por causa dos caracteres "$".
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ---------- Opcional ----------
# PORT=3000
# Se o site roda atrás de proxy reverso (Nginx, Cloudflare...), informe QUANTOS proxies ficam na frente.
# Necessário para o limite por IP enxergar o IP real do visitante.
# TRUST_PROXY=1
